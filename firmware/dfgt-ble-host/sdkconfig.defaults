# Console must stay on UART0 (the CH343 bridge port): the native USB port is the
# wheel's *host* port, and the USB-Serial-JTAG console shares that PHY, so it has
# to be off or host mode cannot work.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# 8 MB header, matching how this board has been flashed all along (the module is
# a 16 MB N16R8; the extra is unused).
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Bluedroid is the only host supported by esp_hid's BLE device path in IDF 4.4.
# Classic BT does not exist on the S3, so this is BLE-only by construction.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
